.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: stretch;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(12px);
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 0 12rpx;
  color: #717182;
}

.tab-item-active {
  color: #030213;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
}

.tab-item-active .tab-icon {
  transform: scale(1.08);
}

.tab-label {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.2;
}

.tab-item-active .tab-label {
  color: #030213;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 4rpx;
  width: 48rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #030213;
}
