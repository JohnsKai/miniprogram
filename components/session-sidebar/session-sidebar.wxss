.sidebar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
}

.sidebar {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 75%;
  max-width: 560rpx;
  background: #fafafa;
  z-index: 201;
  transform: translateX(-100%);
  transition: transform 0.25s ease;
  display: flex;
  flex-direction: column;
  box-shadow: 4rpx 0 24rpx rgba(0, 0, 0, 0.08);
}

.sidebar-open {
  transform: translateX(0);
}

.sidebar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 28rpx 20rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--border);
}

.sidebar-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.sidebar-go-plan {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(3, 2, 19, 0.15);
}

.sidebar-go-plan:active {
  opacity: 0.88;
}

.sidebar-go-plan-icon {
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--primary-fg);
  margin-top: -4rpx;
}

.sidebar-section-label {
  padding: 12rpx 28rpx 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.sidebar-search-wrap {
  padding: 16rpx 24rpx 12rpx;
}

.sidebar-search {
  background: var(--input-bg);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
}

.sidebar-list {
  flex: 1;
  height: 0;
  padding: 0 16rpx;
}

.sidebar-item {
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 8rpx;
}

.sidebar-item-active {
  background: var(--muted);
}

.sidebar-item-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.sidebar-item-delete {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -4rpx;
  margin-right: -8rpx;
  border-radius: 12rpx;
}

.sidebar-item-delete:active {
  background: rgba(0, 0, 0, 0.06);
}

.sidebar-delete-icon {
  font-size: 36rpx;
  line-height: 1;
  color: var(--text-secondary);
}

.sidebar-item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sidebar-pin-icon {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  margin-top: 4rpx;
}

.sidebar-item-pin {
  font-size: 22rpx;
}

.sidebar-item-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-preview {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-item-main {
  flex: 1;
  min-width: 0;
}

.sidebar-item-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.sidebar-status {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.status-interrupted { color: #c2410c; }
.status-planning { color: #f59e0b; }

.sidebar-time {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.sidebar-empty {
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
  padding: 80rpx 0;
}

.sidebar-footer {
  display: none;
}
