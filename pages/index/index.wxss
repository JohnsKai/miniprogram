.page {
  min-height: 100vh;
  padding: 0 32rpx 32rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #eff6ff 0%, #faf5ff 50%, #fdf2f8 100%);
}

/* Banner — 沉浸式顶栏，图片延伸至状态栏区域 */
.banner-wrap {
  position: relative;
  height: 360rpx;
  margin: 0 -32rpx 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 40rpx 48rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.65), transparent);
}

.banner-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.3;
}

.banner-icon {
  font-size: 48rpx;
}

.banner-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* Form card */
.form-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.08);
}

.form-head {
  margin-bottom: 40rpx;
}

.form-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #030213;
}

.form-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #717182;
  line-height: 1.5;
}

.field-block {
  margin-bottom: 36rpx;
}

.field-row {
  margin-bottom: 36rpx;
}

.field-row-2col {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  align-items: flex-start;
}

.field-col {
  flex: 1;
  min-width: 0;
}

.field-label {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #030213;
}

.field-label-between {
  justify-content: space-between;
}

.label-icon {
  font-size: 28rpx;
}

.label-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: #717182;
}

.label-required {
  font-size: 22rpx;
  font-weight: 500;
  color: #dc2626;
}

.field-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #717182;
}

.text-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f3f3f5;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #030213;
  box-sizing: border-box;
}

.days-input-box {
  position: relative;
  display: flex;
  align-items: center;
}

.days-input {
  width: 100%;
  padding-right: 120rpx;
}

.days-suffix {
  position: absolute;
  right: 72rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 26rpx;
  color: #717182;
  pointer-events: none;
}

.days-stepper {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.days-step-btn {
  width: 48rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 18rpx;
  color: #717182;
  border-radius: 8rpx;
}

.days-step-btn:active {
  background: #e9ebef;
  color: #030213;
}

/* Style pills */
.style-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.style-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #030213;
  background: #fff;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
}

.style-pill-active {
  background: #030213;
  color: #fff;
  border-color: #030213;
  box-shadow: 0 4rpx 12rpx rgba(3, 2, 19, 0.15);
}

.style-emoji {
  font-size: 28rpx;
}

/* Budget tiers — 2 列网格 */
.budget-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.budget-tier {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
  padding: 20rpx 12rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
  background: #fff;
}

.budget-tier-emoji {
  font-size: 32rpx;
  line-height: 1.2;
  margin-bottom: 4rpx;
}

.budget-tier-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #030213;
  text-align: center;
  line-height: 1.3;
}

.budget-tier-active .budget-tier-label {
  color: #fff;
}

.budget-tier-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #717182;
  text-align: center;
  line-height: 1.3;
}

.budget-tier-active .budget-tier-sub {
  color: rgba(255, 255, 255, 0.7);
}

.custom-budget-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.custom-budget-prefix,
.custom-budget-suffix {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #717182;
}

.custom-budget-input {
  flex: 1;
  min-width: 0;
}

.steps-badge {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #030213;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
}

.slider-range {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #717182;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: #f3f3f5;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #030213;
  box-sizing: border-box;
}

.textarea-lg {
  min-height: 200rpx;
}

.textarea-sm {
  min-height: 120rpx;
}

.budget-tier-active {
  background: #030213;
  border-color: #030213;
  box-shadow: 0 4rpx 12rpx rgba(3, 2, 19, 0.15);
}

.field-row-textarea .textarea {
  min-height: 192rpx;
}

.btn-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 96rpx;
  margin-top: 8rpx;
  background: #030213;
  color: #fff;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.btn-submit::after {
  border: none;
}

.btn-submit-icon {
  font-size: 36rpx;
}

.footer-tip {
  display: block;
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #717182;
}

.trip-details-block {
  border-top: 1rpx solid #e9ebef;
  padding-top: 24rpx;
}

.trip-details-toggle {
  font-size: 24rpx;
  color: #717182;
}

.sub-field {
  margin-top: 28rpx;
}

.sub-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #030213;
  margin-bottom: 12rpx;
}

.sub-input-row {
  margin-top: 12rpx;
}

.sub-input-hint {
  display: block;
  font-size: 22rpx;
  color: #717182;
  margin-bottom: 8rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f3f3f5;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.picker-row-half {
  flex: 1;
  min-width: 0;
}

.sub-date-row {
  margin-bottom: 0;
}

.picker-label {
  font-size: 26rpx;
  color: #717182;
}

.picker-value {
  font-size: 26rpx;
  color: #030213;
}

.rank-badge {
  margin-left: 4rpx;
  font-size: 20rpx;
  opacity: 0.85;
}

.rank-list {
  margin-top: 12rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #e9ebef;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-num {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #030213;
  color: #fff;
  font-size: 22rpx;
  flex-shrink: 0;
}

.rank-name {
  flex: 1;
  font-size: 26rpx;
  color: #030213;
}

.rank-actions {
  display: flex;
  gap: 8rpx;
}

.rank-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #fff;
  border: 1rpx solid #e9ebef;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #717182;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.tag-pill {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #030213;
  background: #fff;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
}

.tag-pill-sm {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
}

.tag-pill-active {
  background: #030213;
  color: #fff;
  border-color: #030213;
}

.no-limit-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #717182;
}

.slot-row {
  margin-top: 12rpx;
}

.slot-label {
  display: block;
  font-size: 22rpx;
  color: #717182;
  margin-bottom: 8rpx;
}
