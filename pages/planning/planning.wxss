.sessions-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

/* 顶栏 — 适配状态栏 + 胶囊，左菜单 / 中标题 / 右新建 */
.top-bar {
  box-sizing: border-box;
  padding-left: 24rpx;
  background: var(--bg);
  border-bottom: 1rpx solid var(--border);
  flex-shrink: 0;
}

.top-bar-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.top-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.top-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.top-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

/* Tab 栏 */
.tab-bar {
  background: #fff;
  border-bottom: 1rpx solid var(--border);
  white-space: nowrap;
}

.tab-list {
  display: inline-flex;
  padding: 12rpx 16rpx;
  gap: 12rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: var(--input-bg);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.tab-active {
  background: var(--muted);
  color: var(--text);
  font-weight: 600;
}

.tab-title {
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-dot {
  font-size: 16rpx;
  color: #f59e0b;
}

.tab-close {
  font-size: 28rpx;
  color: #999;
  padding-left: 4rpx;
}

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
  background: #fff;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
}

.empty-btn {
  margin-top: 48rpx;
  background: var(--primary);
  color: var(--primary-fg);
  border-radius: 20rpx;
  padding: 0 64rpx;
  font-size: 28rpx;
  border: none;
}

.empty-btn::after {
  border: none;
}

.chat-page {
  flex: 1;
  height: 0;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.session-loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.session-loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.load-older-hint {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}

.load-older-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.chat-scroll {
  flex: 1;
  height: 0;
}

.chat-list {
  padding: 24rpx;
  padding-bottom: 16rpx;
  max-width: 100%;
}

.chat-bottom-space {
  height: 32rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
  gap: 16rpx;
}

.msg-row-user {
  justify-content: flex-end;
}

.msg-row-assistant {
  justify-content: flex-start;
}

.msg-row-route {
  align-items: flex-start;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-ai {
  background: var(--primary);
  color: var(--primary-fg);
  font-size: 28rpx;
}

.avatar-user {
  background: var(--user-avatar-bg);
  color: var(--user-avatar-fg);
}

.avatar-spacer {
  background: transparent;
  visibility: hidden;
}

/* 气泡 */
.bubble {
  max-width: calc(100% - 96rpx);
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
}

.bubble-user {
  background: var(--primary);
  border-top-right-radius: 8rpx;
}

.bubble-user .bubble-text {
  color: var(--primary-fg);
}

.bubble-assistant {
  background: var(--muted);
  border-top-left-radius: 8rpx;
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text);
  word-break: break-word;
}

.bubble-pre {
  white-space: pre-wrap;
}

.bubble-thinking {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bubble-phase {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: #f8f8fa;
  border-left: 4rpx solid var(--text-secondary);
  border-top-left-radius: 8rpx;
}

.phase-step-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  background: var(--muted);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}

.phase-label {
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}

.thinking-label {
  color: var(--text-secondary);
  font-size: 26rpx;
}

.thinking-dots {
  display: flex;
  gap: 8rpx;
}

.thinking-dots .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  animation: blink 1.2s infinite;
}

.thinking-dots .dot:nth-child(2) { animation-delay: 0.2s; }
.thinking-dots .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 80%, 100% { opacity: 0.3; }
  40% { opacity: 1; }
}

.route-wrap {
  flex: 1;
  min-width: 0;
  max-width: calc(100% - 80rpx);
}

.msg-row-route .bubble {
  max-width: 100%;
}

.bubble-route-intro {
  max-width: 100%;
  margin-bottom: 4rpx;
}

.route-unified-card {
  margin-top: 0;
}

.bubble-route-footer {
  max-width: calc(100% - 96rpx);
}

.msg-row-route-footer {
  margin-top: -8rpx;
}

.summary-card {
  margin-top: 16rpx;
  padding: 28rpx 32rpx;
  background: var(--input-bg);
  border-radius: 20rpx;
  border-left: 6rpx solid var(--primary);
}

.summary-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}

.summary-body {
  display: block;
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--text);
}

.route-wrap-days {
  position: relative;
}

.plan-overlay {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow);
}

.plan-overlay-text {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.6;
}

.route-cards {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 底部输入 */
.chat-footer {
  flex-shrink: 0;
  background: var(--bg);
  border-top: 1rpx solid var(--border);
}

.interrupt-banner {
  padding: 20rpx 24rpx;
  background: #fff7ed;
  border-bottom: 1rpx solid #fed7aa;
}

.intake-progress-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #eff6ff;
  border-bottom: 1rpx solid #dbeafe;
}

.intake-progress-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #1d4ed8;
}

.intake-category-text {
  font-size: 22rpx;
  color: #64748b;
  flex-shrink: 0;
}

.plan-steps-hint-bar {
  padding: 16rpx 24rpx;
  background: #fff7ed;
  border-bottom: 1rpx solid #fed7aa;
}

.plan-steps-hint-text {
  font-size: 24rpx;
  line-height: 1.5;
  color: #c2410c;
}

.degraded-hint-bar {
  padding: 16rpx 24rpx;
  background: #fef3c7;
  border-bottom: 1rpx solid #fcd34d;
}

.degraded-hint-text {
  font-size: 24rpx;
  line-height: 1.5;
  color: #92400e;
}

.interrupt-banner-text {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #c2410c;
  line-height: 1.5;
}

.ask-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 24rpx 0;
}

.ask-option-chip {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #030213;
  background: #ececf0;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 999rpx;
  line-height: 1.35;
}

.chat-input-wrap {
  padding: 20rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.chat-input-box {
  display: flex;
  align-items: center;
  padding: 8rpx 8rpx 8rpx 24rpx;
  background: var(--input-bg);
  border-radius: 32rpx;
  border: 1rpx solid var(--border);
}

.chat-input {
  flex: 1;
  width: 0;
  height: 72rpx;
  font-size: 28rpx;
  background: transparent;
}

.chat-send-btn {
  width: 20%;
  max-width: 120rpx;
  min-width: 72rpx;
  height: 72rpx;
  padding: 0;
  margin: 0;
  border-radius: 0;
  background: transparent;
  border: none;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-send-btn::after {
  border: none;
}

.chat-send-plane {
  width: 44rpx;
  height: 44rpx;
}

.chat-send-btn[disabled] .chat-send-plane {
  opacity: 0.35;
}

.chat-input-hint {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-secondary);
}
