.page {
  padding: 32rpx;
  padding-bottom: 200rpx;
}

.overview {
  margin-bottom: 32rpx;
}

.overview-query {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.overview-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.style-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.style-tag {
  padding: 6rpx 20rpx;
  background: rgba(45, 91, 79, 0.1);
  color: var(--primary);
  border-radius: 20rpx;
  font-size: 24rpx;
}

.detail-entry {
  border-top: 1rpx solid #F0EDE8;
  padding-top: 24rpx;
}

.detail-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #2D5B4F;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin-bottom: 20rpx;
}

.detail-btn::after {
  border: none;
}

.view-tabs {
  display: flex;
  gap: 16rpx;
}

.view-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: #F0EDE8;
  border-radius: 16rpx;
}

.view-tab.active {
  background: rgba(45, 91, 79, 0.12);
  color: #2D5B4F;
  font-weight: 600;
}

.days-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  margin-bottom: 24rpx;
  border-left: 6rpx solid var(--primary);
}

.summary-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 12rpx;
}

.summary-body {
  display: block;
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--text);
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.fallback-btn {
  margin-top: 24rpx;
  background: #2D5B4F;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.fallback-btn::after {
  border: none;
}

.raw-text-panel {
  margin-bottom: 32rpx;
}

.raw-text-content {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text);
  white-space: pre-wrap;
  word-break: break-all;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 40rpx;
}

.action-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  padding: 20rpx 36rpx;
  background: var(--primary);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(45, 91, 79, 0.3);
  z-index: 101;
}
